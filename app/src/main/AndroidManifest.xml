<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <permission android:name="dev.local.supercardhost.permission.READ_MEMORY_TRANSFER"
        android:protectionLevel="signature" />
    <queries>
        <package android:name="com.coloros.smartsidebar" />
        <package android:name="com.finshell.wallet" />
        <package android:name="com.oplus.aimemory" />
        <package android:name="com.oplus.camera" />
        <package android:name="com.android.camera" />
        <package android:name="com.tencent.mm" />
        <package android:name="com.eg.android.AlipayGphone" />
    </queries>
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <application android:label="超级卡包" android:theme="@android:style/Theme.Material.Light.NoActionBar" android:allowBackup="false"
        android:networkSecurityConfig="@xml/dhu_network_security">
        <provider android:name=".DhuPayProvider" android:authorities="dev.local.supercardhost.dhu-pay"
            android:exported="true" />
        <activity android:name=".DhuPaySettingsActivity" android:exported="true" />
        <provider android:name=".RootDisplayBootstrapProvider"
            android:authorities="dev.local.supercardhost.root-bootstrap" android:exported="false" />
        <receiver android:name=".RootDisplayStartReceiver" android:exported="true"
            android:permission="android.permission.DUMP" />
        <service android:name=".RootDisplayStartService" android:exported="true"
            android:permission="android.permission.DUMP" />
        <receiver android:name=".RootDisplayBootReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <service android:name=".MemoryTransferService" android:exported="true"
            android:permission="android.permission.DUMP" />
        <provider android:name=".MemoryTransferProvider"
            android:authorities="dev.local.supercardhost.memory-transfer"
            android:exported="true"
            android:readPermission="dev.local.supercardhost.permission.READ_MEMORY_TRANSFER"
            android:writePermission="android.permission.DUMP"
            android:grantUriPermissions="true" />
        <activity android:name=".GestureAreaActivity" android:exported="true" />
        <activity android:name=".HostToolsActivity" android:exported="false" />
        <activity android:name=".CardManagementActivity" android:exported="false" />
        <activity android:name=".CardFunctionSettingsActivity" android:exported="false" />
        <activity-alias android:name="com.vivo.card.setting.CardEditActivity"
            android:targetActivity=".CardFunctionSettingsActivity" android:exported="true" />
        <activity-alias android:name="com.vivo.card.setting.CardSettingActivity"
            android:targetActivity=".CardManagementActivity" android:exported="true" />
        <activity android:name=".MemoryPhotoActivity" android:exported="true"
            android:permission="android.permission.DUMP"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <activity android:name=".NativeCardsActivity" android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" android:excludeFromRecents="true" />
        <activity android:name=".HostActivity" android:exported="true">
            <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="de.robv.android.xposed.category.MODULE_SETTINGS" />
            </intent-filter>
        </activity>
    </application>
</manifest>
