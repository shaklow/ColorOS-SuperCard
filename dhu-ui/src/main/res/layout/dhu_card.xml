<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto" style="@style/Dhu.Card"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:padding="16dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="48dp"
            android:gravity="center_vertical" android:orientation="horizontal">
            <com.google.android.material.imageview.ShapeableImageView android:layout_width="36dp"
                android:layout_height="36dp" android:padding="8dp" android:src="@drawable/dhu_ic_school"
                android:backgroundTint="?attr/colorPrimaryContainer" android:background="@android:color/white"
                app:tint="?attr/colorOnPrimaryContainer" app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Medium" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:layout_marginStart="10dp" android:orientation="vertical">
                <com.google.android.material.textview.MaterialTextView android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:text="@string/dhu_title" android:textSize="18sp"
                    android:textAppearance="?attr/textAppearanceTitleMedium" android:maxLines="1" android:ellipsize="end" />
                <com.google.android.material.textview.MaterialTextView android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:text="@string/dhu_account" android:textSize="12sp"
                    android:textColor="?attr/colorOnSurfaceVariant" android:maxLines="1" android:ellipsize="end" />
            </LinearLayout>
            <com.google.android.material.button.MaterialButton style="?attr/materialIconButtonStyle"
                android:tag="dhu_settings" android:layout_width="48dp" android:layout_height="48dp"
                android:contentDescription="@string/dhu_settings" app:icon="@drawable/dhu_ic_settings" />
        </LinearLayout>
        <com.google.android.material.card.MaterialCardView style="@style/Dhu.CodeSurface"
            android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
            android:layout_marginTop="12dp">
            <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent">
                <LinearLayout android:tag="dhu_codes" android:layout_width="match_parent"
                    android:layout_height="match_parent" android:orientation="vertical"
                    android:gravity="center_horizontal" android:padding="10dp" android:visibility="invisible">
                    <ImageView android:tag="dhu_qr" android:layout_width="match_parent"
                        android:layout_height="0dp" android:layout_weight="1" android:scaleType="fitCenter"
                        android:background="#FFFFFFFF" android:contentDescription="@string/dhu_qr_description" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="@string/dhu_hint" android:textColor="#FF626976" android:textSize="11sp"
                        android:gravity="center" android:layout_marginTop="2dp" android:layout_marginBottom="10dp" />
                    <ImageView android:tag="dhu_barcode" android:layout_width="match_parent"
                        android:layout_height="46dp" android:scaleType="fitCenter" android:background="#FFFFFFFF"
                        android:contentDescription="@string/dhu_bar_description" />
                    <com.google.android.material.button.MaterialButton style="@style/Widget.Material3Expressive.Button.TextButton"
                        android:tag="dhu_numbers" android:layout_width="wrap_content" android:layout_height="40dp"
                        android:text="@string/dhu_digits" android:textSize="12sp" android:minHeight="0dp"
                        android:insetTop="0dp" android:insetBottom="0dp" />
                </LinearLayout>
                <LinearLayout android:tag="dhu_empty" android:layout_width="match_parent"
                    android:layout_height="match_parent" android:gravity="center" android:orientation="vertical"
                    android:padding="20dp" android:contentDescription="点击码区重试">
                    <ImageView android:tag="dhu_empty_icon" android:layout_width="48dp" android:layout_height="48dp"
                        android:src="@drawable/dhu_ic_school" android:tint="#FF7D8CA4" />
                    <com.google.android.material.loadingindicator.LoadingIndicator android:tag="dhu_loading"
                        android:layout_width="48dp" android:layout_height="48dp" android:visibility="gone" />
                    <TextView android:tag="dhu_empty_message" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:gravity="center" android:text="@string/dhu_empty"
                        android:textColor="#FF626976" android:textSize="12sp" android:layout_marginTop="14dp" />
                </LinearLayout>
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:layout_marginTop="14dp" android:paddingHorizontal="4dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="center_vertical" android:orientation="horizontal">
                <com.google.android.material.textview.MaterialTextView android:tag="dhu_status"
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:textSize="12sp" android:textColor="?attr/colorOnSurfaceVariant" android:maxLines="2"
                    android:accessibilityLiveRegion="polite" />
                <com.google.android.material.textview.MaterialTextView android:tag="dhu_countdown"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="8dp" android:textSize="13sp" android:textColor="?attr/colorPrimary"
                    android:visibility="gone" />
            </LinearLayout>
            <com.google.android.material.progressindicator.LinearProgressIndicator
                style="@style/Widget.Material3Expressive.LinearProgressIndicator"
                android:tag="dhu_progress" android:layout_width="match_parent" android:layout_height="4dp"
                android:layout_marginTop="10dp" android:max="60" android:visibility="invisible"
                app:trackThickness="4dp" app:trackCornerRadius="2dp" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
